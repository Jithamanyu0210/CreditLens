# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/creditlens
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/creditlens?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/creditlens
MONGODB_DB_NAME=creditlens

# JWT Secret Key for Session Authentication (Change in production)
JWT_SECRET=creditlens_fintech_secure_jwt_secret_change_in_production_2026

# Google Gemini API Key for AI Financial Explanations & Insights
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
