# ==============================================================================
# CreditLens Root .env.example
# Copy this file to backend/.env and update the values with your credentials.
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/creditlens
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/creditlens?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/creditlens
MONGODB_DB_NAME=creditlens

# JWT Secret Key for Session Signing (Change to a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_creditlens_fintech_secure_2026

# Google Gemini API Key for Natural Language Explanations (Optional)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
