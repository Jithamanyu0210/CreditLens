# Root .gitignore for CreditLens

# Node dependencies
node_modules/
package-lock.json.bak

# Environment variables and sensitive credentials
.env
.env.*
.env.local
.env.*.local
*.env
!.env.example
!.env.sample

# Build outputs
dist/
dist-ssr/
build/
coverage/

# Logs & temporary profiles
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
temp_chrome_profile/
temp_chrome_profile*/

# System & IDE files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
